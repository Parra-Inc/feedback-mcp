out/
.DS_Store
*.log

# Raw capture media is large and regenerated by the capture step. Commit the
# final rendered video (out/ is ignored, so copy the mp4 out when you ship it),
# not the intermediate clips.
public/captures/*.webm
public/captures/*.mp4
public/captures/raw/
capture/test-results/
playwright-report/

